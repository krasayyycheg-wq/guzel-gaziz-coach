# ============================================================
# Секреты НЕ коммитить. Скопируйте этот файл в .env (локально)
# и задайте те же переменные в Vercel → Project → Settings → Environment Variables.
# ============================================================

# --- Telegram-уведомления о заявках и тестах (серверная часть, api/lead.ts) ---
# 1. Напишите @BotFather → /newbot → получите токен вида 123456:ABC-...
# 2. Узнайте chat_id: напишите боту любое сообщение, затем откройте
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates — chat.id у сообщения.
#    Для группы добавьте бота в группу; chat_id группы отрицательный.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Яндекс.Метрика (клиентская часть) ---
# ID счётчика из metrika.yandex.ru (только цифры).
# Счётчик загружается после согласия пользователя в cookie-баннере.
VITE_YANDEX_METRIKA_ID=

# --- Яндекс Таблицы (через официальный API Яндекс Форм) ---
# У Яндекс Таблиц нет официального API для записи строк напрямую,
# поэтому лиды пишутся через Яндекс Форму, связанную с таблицей:
# 1. Создайте форму на forms.yandex.ru.
# 2. Добавьте в неё одно текстовое поле с вопросом «Данные заявки».
# 3. В настройках формы привяжите ответы к Яндекс Таблице (Ответы → таблица).
# 4. Выпустите OAuth-токен: https://oauth.yandex.ru/authorize?response_type=token&client_id=<ID приложения>
#    (приложение с доступом к Яндекс Формам создаётся на oauth.yandex.ru).
YANDEX_FORMS_OAUTH_TOKEN=
YANDEX_FORMS_FORM_ID=
