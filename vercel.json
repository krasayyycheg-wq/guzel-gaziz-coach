{
  "functions": {
    "api/lead.ts": { "maxDuration": 30 },
    "api/telegram.ts": { "maxDuration": 30 },
    "api/cron.ts": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron?job=reminders", "schedule": "0 6 * * *" },
    { "path": "/api/cron?job=weekly", "schedule": "0 6 * * 1" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
